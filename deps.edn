{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). Both
 ;; live in the kotoba-lang org of this workspace. This repo is
 ;; standalone (forkable outside the workspace); the :local/root paths
 ;; only resolve inside the monorepo checkout -- a standalone fork
 ;; should override them with git coordinates. langchain is pinned here
 ;; directly (not only under :dev) so a bare `clojure -M:test` works
 ;; offline inside the monorepo checkout without depending on
 ;; langgraph's own transitive git/sha pin being fetchable.
 ;;
 ;; Engine-under-the-hood rewiring (this build): four shared/real
 ;; infrastructure deps replace formerly-bespoke internal
 ;; implementations, same sibling-checkout `:local/root` convention as
 ;; every dep above (matches `cloud-itonami-isic-5820`'s own
 ;; `io.github.kotoba-lang/crm` entry) --
 ;;   - `io.github.cloud-itonami/cloud-itonami-regulatory-tracker` --
 ;;     `hygaccess.regulatory` now delegates to this shared library's
 ;;     `cloud-itonami.regulatory-tracker.core` instead of its own
 ;;     hand-rolled stage table.
 ;;   - `io.github.kotoba-lang/dcs` -- `hygaccess.mes` now backs its
 ;;     mock telemetry source on `dcs.ports/IFieldIO` instead of a
 ;;     bespoke `MESSource` protocol.
 ;;   - `io.github.kotoba-lang/kami-app-hygaccess-plant` -- the mock
 ;;     IFieldIO's mixing-homogeneity tag reads through this repo's own
 ;;     real, tested CFD solve (`kami-app-hygaccess-plant.mixing/
 ;;     run-mixing-scenario`) instead of a canned/hand-picked number.
 ;;   - `io.github.kotoba-lang/crm` -- `hygaccess.registry`'s
 ;;     fulfillment-status transition table now delegates to
 ;;     `kotoba.crm.pipeline`'s generic ordered-stage/exit-stage
 ;;     validator instead of a bespoke hand-rolled table.
 :deps {io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain
        {:local/root "../../kotoba-lang/langchain"}
        io.github.cloud-itonami/cloud-itonami-regulatory-tracker
        {:local/root "../cloud-itonami-regulatory-tracker"}
        io.github.kotoba-lang/dcs
        {:local/root "../../kotoba-lang/dcs"}
        io.github.kotoba-lang/kami-app-hygaccess-plant
        {:local/root "../../kotoba-lang/kami-app-hygaccess-plant"}
        io.github.kotoba-lang/crm
        {:local/root "../../kotoba-lang/crm"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  ;; (kept for parity with sibling actors' deps.edn shape; redundant
  ;; with the top-level :deps override above).
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "hygaccess.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
